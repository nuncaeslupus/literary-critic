{"send": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": {"name": "claude-ai", "version": "0.1.0"}}}, "expect": {"jsonrpc": "2.0", "id": 1, "result": {"protocolVersion": "2025-06-18", "capabilities": {"tools": {}}, "serverInfo": {"name": "literary-critic", "version": "0.0.0-test"}, "instructions": "test guide"}}}
{"send": {"jsonrpc": "2.0", "method": "notifications/initialized"}, "expect": null}
{"send": {"jsonrpc": "2.0", "id": 2, "method": "tools/list"}, "expect": {"jsonrpc": "2.0", "id": 2, "result": {"tools": [{"name": "echo", "description": "Echo the word back.", "inputSchema": {"type": "object", "properties": {"word": {"type": "string"}}, "required": ["word"]}}, {"name": "refuse", "description": "Always refused.", "inputSchema": {"type": "object", "properties": {}}}, {"name": "crash", "description": "Always crashes.", "inputSchema": {"type": "object", "properties": {}}}]}}}
{"send": {"jsonrpc": "2.0", "id": 3, "method": "tools/call", "params": {"name": "echo", "arguments": {"word": "Doña"}}}, "expect": {"jsonrpc": "2.0", "id": 3, "result": {"content": [{"type": "text", "text": "{\n \"word\": \"Doña\"\n}"}], "isError": false}}}
