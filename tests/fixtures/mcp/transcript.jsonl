{"send": {"jsonrpc": "2.0", "id": 5, "method": "tools/call", "params": {"name": "refuse", "arguments": {}}}, "expect": {"jsonrpc": "2.0", "id": 5, "result": {"content": [{"type": "text", "text": "{\n \"error\": \"outside_granted_folders\",\n \"path\": \"x\"\n}"}], "isError": true}}}
{"send": {"jsonrpc": "2.0", "id": 6, "method": "tools/call", "params": {"name": "crash", "arguments": {}}}, "expect": {"jsonrpc": "2.0", "id": 6, "result": {"content": [{"type": "text", "text": "{\n \"error\": \"internal\",\n \"detail\": \"RuntimeError('boom')\"\n}"}], "isError": true}}}
{"send": {"jsonrpc": "2.0", "id": 7, "method": "tools/call", "params": {"name": "nope"}}, "expect": {"jsonrpc": "2.0", "id": 7, "error": {"code": -32602, "message": "unknown tool: nope"}}}
