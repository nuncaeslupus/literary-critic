{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "profile",
  "title": "Novel profile (analysis/profile.toml): mode, traits and check adjustments",
  "type": "object",
  "required": ["mode", "language"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "mode": {"enum": ["revision", "reader-report"]},
    "language": {"type": "string", "pattern": "^[a-z]{2}$"},
    "traits": {"type": "array", "items": {"type": "string", "pattern": "^[a-z_]+$"}},
    "disabled": {"type": "array", "items": {"type": "string"}},
    "weights": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
    "prose_suggestions": {"type": "boolean", "default": false,
      "description": "The assistant may propose wording (off by default; needs ai_notice_ack)"},
    "ai_notice_ack": {"type": "string",
      "description": "When the writer acknowledged the AI-text notice (UTC, ISO 8601)"}
  }
}
