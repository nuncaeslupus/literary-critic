{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scene-card",
  "title": "Scene card (LLM-written, one per scene)",
  "type": "object",
  "required": ["schema_version", "anchor", "summary", "pov", "characters", "location", "story_time", "events"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "anchor": {"$ref": "#/$defs/scene_anchor"},
    "summary": {"type": "string", "minLength": 1, "x-maxWords": 80},
    "pov": {"type": "string", "description": "point-of-view character, or 'omniscient' / 'none'"},
    "characters": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "location": {"type": "string"},
    "story_time": {"type": "string", "description": "when it happens in the story, as precise as the text allows"},
    "events": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "setups": {"type": "array", "items": {"type": "string"}},
    "payoffs": {"type": "array", "items": {"type": "string"}},
    "open_threads": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  },
  "$defs": {
    "scene_anchor": {"type": "string", "pattern": "^(p[0-9]+\\.)?c[0-9]+\\.s[0-9]+$"}
  }
}
