{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding",
  "title": "Finding: the result of one check at one or more places in the text",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "check_id",
    "anchors",
    "evidence",
    "severity",
    "confidence",
    "effort",
    "kind",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^F[0-9]+$"
    },
    "check_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+\\.[a-z0-9_-]+$"
    },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/anchor"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "anchor",
          "quote"
        ],
        "additionalProperties": false,
        "properties": {
          "anchor": {
            "$ref": "#/$defs/anchor"
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "x-maxWords": 25
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "explanation": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "effort": {
      "enum": [
        "S",
        "M",
        "L"
      ]
    },
    "kind": {
      "enum": [
        "problem",
        "strength"
      ]
    },
    "status": {
      "enum": [
        "open",
        "accepted",
        "rejected",
        "resolved",
        "stale"
      ]
    },
    "what": {
      "type": "string",
      "minLength": 1,
      "description": "what the writer could change, in one line (no replacement prose)"
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "ways to address it, described, never written out"
    }
  },
  "$defs": {
    "anchor": {
      "type": "string",
      "pattern": "^(p[0-9]+\\.)?c[0-9]+(\\.s[0-9]+(\\.p[0-9]+)?)?$"
    }
  }
}
