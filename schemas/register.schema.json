{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "register",
  "title": "Register derived from scene cards: characters, locations, relationships, timeline, motifs, setups",
  "type": "object",
  "required": ["schema_version", "kind", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"enum": ["characters", "locations", "relationships", "timeline", "motifs", "setups"]},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "anchors"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "anchors": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(p[0-9]+\\.)?c[0-9]+(\\.s[0-9]+(\\.p[0-9]+)?)?$"}},
          "related": {"type": "array", "items": {"type": "string"}},
          "story_time": {"type": "string"},
          "status": {"enum": ["open", "paid_off", "dropped"]},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
